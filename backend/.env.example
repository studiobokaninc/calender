# Dify API設定（ダッシュボード・管理者用）
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_URL=http://your-dify-server/v1
DIFY_USER=your_email@example.com

# 一般ユーザー専用チャット用（専用チャットページで使用）
DIFY_API_KEY_USER=your_dify_api_key_for_general_users
# 未設定の場合は DIFY_API_URL / DIFY_USER を流用
# DIFY_API_URL_USER=
# DIFY_USER_USER=

# セキュリティ設定
SECRET_KEY=your_secret_key_here_change_in_production

# CLI/MCPバイパストークン（Score CLI・MCP用。ブラウザでは使用しない）
# CLI_BYPASS_TOKEN=your_cli_bypass_token_here

# 監査ログREST専用サービストークン（/api/audit/logs のみ使用。MCPのget_eventsはDB直読みのため不要）
# CALENDER_SERVICE_TOKEN=your_calender_service_token_here

# CORS設定
# ローカル開発のみの場合:
# CORS_ORIGINS=http://localhost:5175

# ローカルネットワークからのアクセスを許可する場合:
# CORS_ORIGINS=http://localhost:5175,http://192.168.1.100:5175

# 外部アクセスを許可する場合（開発環境のみ、本番環境では非推奨）:
# CORS_ALLOW_ALL=true
# または特定のオリジンのみ許可:
# CORS_ORIGINS=http://localhost:5175,http://your-external-ip:5175

# トークン有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ローカルLLM設定 (Ollama, scripts/generate_ai_insights.py / 議事録解析)
# LLM_PROVIDER=local に設定するとOllamaを使用 (cloud APIキー不要)
# LLM_PROVIDER=local
# 接続先URL: CALENDER_LLM_BASE_URL 優先。未設定なら LOCAL_LLM_BASE_URL にフォールバック。
# 他システムと Ollama を共有する環境で LOCAL_LLM_BASE_URL が別用途に使われている場合、
# calender 側は CALENDER_LLM_BASE_URL を使うこと。
# 例: 別マシン(BOX2)の Ollama をLAN経由で使う
# CALENDER_LLM_BASE_URL=http://192.168.44.78:11434/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b

# ローカルWhisper設定 (音声書き起こし)
# WHISPER_BACKEND=auto  # auto=Cloud優先→ローカルfallback / local=ローカル強制
# WHISPER_MODEL=medium  # tiny/base/small/medium/large (大きいほど高精度・遅い)

# --- 議事録生成AIエージェント連携 (docs/calendar_integration_spec.md) ---
# 有効化スイッチ。false なら従来どおりローカル解析(MeetingAnalyzer + WHISPER_* / CALENDER_LLM_BASE_URL)のみ。
# MINUTES_AGENT_ENABLED=false
# エージェントサーバーのベースURL（末尾スラッシュ無し）
# MINUTES_AGENT_URL=http://192.168.44.139:8090
# 共有静的トークン。エージェントが音声GET / 結果PATCH の Authorization: Bearer に使う。
# エージェント側 .env の MAIN_SERVER_API_KEY と同じ値にすること。長いランダム文字列推奨。
# MINUTES_AGENT_TOKEN=change_me_long_random_token
# エージェントから見たカレンダー自身のベースURL (callback_url として送信)。
# localhost / 127.0.0.1 は不可（別マシンから叩かれるため）。/api は付けない。
#   本番機: http://192.168.44.253:8001   開発機(BOX2): http://192.168.44.78:8001
# 誤った値でも dispatch は accepted で成功して見え、エージェントが折り返せないまま
# タイムアウトするまで気づけない。委譲時に自ホストIPと不一致なら警告ログを出している。
# CALENDAR_PUBLIC_BASE_URL=http://192.168.44.253:8001
# /process_meeting POST のタイムアウト秒（即座に accepted が返る想定）
# MINUTES_AGENT_DISPATCH_TIMEOUT=15
# 1ジョブの最大待ち時間(秒)。超えたらタイムアウト扱い。既定6時間。
# 起動時の孤児クリーンアップでも、この時間内の委譲中ジョブは failed にしない。
# MINUTES_AGENT_JOB_TIMEOUT_SEC=21600
# エージェントが失敗した時にローカル解析へ自動フォールバックするか
# MINUTES_AGENT_FALLBACK_ON_FAILED_CALLBACK=true
# /health プロキシ (GET /api/admin/minutes-agent/health) のタイムアウト秒
# MINUTES_AGENT_HEALTH_TIMEOUT=3
